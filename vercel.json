{
  "git": {
    "deploymentEnabled": { "dependabot/**": false }
  },
  "buildCommand": "npm run build:react-runner && npm ci --prefix client && npm run build --prefix client",
  "outputDirectory": "client/dist",
  "framework": null,
  "regions": [
    "arn1"
  ],
  "functions": {
    "api/quiz/roadmap.ts": {
      "maxDuration": 45,
      "includeFiles": "{lib/coding/generated/*.cjs,node_modules/typescript/lib/lib.{es,decorators}*.d.ts}",
      "excludeFiles": "node_modules/typescript/lib/{lib{,.dom{,.asynciterable,.iterable},.scripthost,.webworker{,.asynciterable,.importscripts,.iterable}},tsserverlibrary,typescript}.d.ts"
    },
    "api/**/*.ts": {
      "maxDuration": 10,
      "excludeFiles": "node_modules/typescript/lib/{lib{,.dom{,.asynciterable,.iterable},.scripthost,.webworker{,.asynciterable,.importscripts,.iterable}},tsserverlibrary,typescript}.d.ts"
    }
  },
  "routes": [
    {
      "src": "^/.*$",
      "has": [{ "type": "host", "value": "react-express-app-five.vercel.app" }],
      "headers": { "X-Robots-Tag": "noindex" },
      "continue": true
    },
    {
      "src": "^/(?!assets/coding-worker/|sandbox/).*$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), interest-cohort=()",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "Reporting-Endpoints": "csp=\"/api/settings?op=csp-report\"",
        "Content-Security-Policy": "default-src 'self'; object-src 'none'; script-src 'self' https://js.stripe.com https://*.js.stripe.com https://checkout.stripe.com 'sha256-GJpptaB9Bz6CfF0DRrD6q4aJv4Y6KtADhfPP5CcRGMQ='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.googleusercontent.com https://*.stripe.com https://*.link.com; connect-src 'self' https://api.stripe.com https://checkout.stripe.com https://link.com https://*.link.com https://rvlybcjdpafwyeuojvhl.supabase.co wss://rvlybcjdpafwyeuojvhl.supabase.co https://o4511808879001600.ingest.de.sentry.io; frame-src 'self' https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://link.com https://*.link.com; child-src 'self' https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://link.com https://*.link.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; worker-src 'self'; report-uri /api/settings?op=csp-report; report-to csp; upgrade-insecure-requests"
      },
      "continue": true
    },
    {
      "src": "^/(?!api(?:/|$)|ingest(?:/|$)|(?:assets|sandbox|brand|og|\\.well-known)(?:/|$))(?:(?:[^/]+/)*[^/.]*|.*\\.html)/?$",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
        "Cross-Origin-Resource-Policy": "same-origin"
      },
      "continue": true
    },
    {
      "src": "^/(?:admin(?:/.*)?|premium/(?:success|checkout)|auth/confirmed|reset-password|profile|cards|collection|shop|today|settings/github|dev|play(?:/.*)?)/?$",
      "headers": {
        "X-Robots-Tag": "noindex"
      },
      "continue": true
    },
    {
      "src": "^/assets/coding-worker/.*$",
      "headers": {
        "Content-Security-Policy": "default-src 'none'; script-src 'self' 'unsafe-eval'",
        "X-Content-Type-Options": "nosniff",
        "Cross-Origin-Resource-Policy": "same-origin"
      },
      "continue": true
    },
    {
      "src": "^/sandbox/.*$",
      "headers": {
        "Content-Security-Policy": "default-src 'none'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src data:; font-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'; sandbox allow-scripts allow-forms",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/(?!api(?:/|$)|sandbox(?:/|$)|ingest(?:/|$)).*$",
      "headers": {
        "Access-Control-Allow-Origin": "https://devshark.app"
      },
      "continue": true
    },
    {
      "src": "^/api(?:/|$).*",
      "headers": {
        "Cross-Origin-Resource-Policy": "same-origin"
      },
      "continue": true
    },
    {
      "src": "^/(?:t|%74)(?:r|%72)(?:i|%69)(?:a|%61)(?:g|%67)(?:e|%65)(?:-|%2[dD])(?:v|%76)(?:e|%65)(?:r|%72)(?:d|%64)(?:i|%69)(?:c|%63)(?:t|%74)(?:s|%73)(?:\\.|%2[eE])(?:j|%6[aA])(?:s|%73)(?:o|%6[fF])(?:n|%6[eE])$",
      "headers": {
        "Cache-Control": "no-store"
      },
      "status": 404
    },
    {
      "src": "^/(?:sandbox/)?assets/.+\\.map$",
      "headers": {
        "Cache-Control": "no-store"
      },
      "status": 404
    },
    {
      "src": "^/support/?$",
      "status": 308,
      "headers": { "Location": "/premium" }
    },
    {
      "src": "^/roadmap/specializations/fde/?$",
      "headers": {
        "Location": "/learn/web-developer"
      },
      "status": 308
    },
    {
      "src": "^/roadmap/specializations/fde/([^/]+)(?:/.*)?$",
      "headers": {
        "Location": "/learn/web-developer"
      },
      "status": 308
    },
    {
      "src": "^/roadmap/paths/dsa-foundations(?:/.*)?$",
      "headers": {
        "Location": "/learn/software-engineer?topic=dsa"
      },
      "status": 308
    },
    {
      "src": "^/cs/topics(?:/.*)?$",
      "dest": "/app.html",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?:(?:sandbox/)?assets|brand|og)/.*$",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "handle": "hit"
    },
    {
      "src": "^/(?:sandbox/)?assets/.*$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/ingest/static/(.*)",
      "destination": "https://eu-assets.i.posthog.com/static/$1"
    },
    {
      "source": "/ingest/(.*)",
      "destination": "https://eu.i.posthog.com/$1"
    },
    {
      "source": "/topics/:slug",
      "destination": "/topics/:slug/index.html"
    },
    {
      "source": "/premium",
      "destination": "/premium/index.html"
    },
    {
      "source": "/premium/cancel",
      "destination": "/premium/cancel/index.html"
    },
    {
      "source": "/daily",
      "destination": "/daily/index.html"
    },
    {
      "source": "/daily/:date",
      "destination": "/daily/:date/index.html"
    },
    {
      "source": "/coding",
      "destination": "/coding/index.html"
    },
    {
      "source": "/coding/system-design",
      "destination": "/coding/system-design/index.html"
    },
    {
      "source": "/coding/system-design/(.*)",
      "destination": "/coding/system-design/index.html"
    },
    {
      "source": "/coding/:track",
      "destination": "/coding/:track/index.html"
    },
    {
      "source": "/coding/:track/:taskId",
      "destination": "/coding/:track/:taskId/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/learn/web-developer",
      "destination": "/learn/web-developer/index.html"
    },
    {
      "source": "/learn/software-engineer",
      "destination": "/learn/software-engineer/index.html"
    },
    {
      "source": "/quiz",
      "destination": "/quiz/index.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/leaderboard/index.html"
    },
    {
      "source": "/typing",
      "destination": "/typing/index.html"
    },
    {
      "source": "/challenge",
      "destination": "/challenge/index.html"
    },
    {
      "source": "/classroom",
      "destination": "/classroom/index.html"
    },
    {
      "source": "/big-o",
      "destination": "/big-o/index.html"
    },
    {
      "source": "/learn/big-o",
      "destination": "/learn/big-o/index.html"
    },
    {
      "source": "/roadmap",
      "destination": "/roadmap/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/|ingest/|sandbox/|topics/|brand/|og/).*)",
      "destination": "/app.html"
    }
  ]
}
