{
  "buildCommand": "npm run build:react-runner && npm ci --prefix client && npm run build --prefix client",
  "outputDirectory": "client/dist",
  "framework": null,
  "regions": [
    "arn1"
  ],
  "functions": {
    "api/quiz/roadmap.ts": {
      "maxDuration": 45,
      "includeFiles": "{lib/coding/generated/*.cjs,node_modules/typescript/lib/lib.*.d.ts}"
    },
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "^/(?!assets/coding-worker/|sandbox/).*$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), interest-cohort=()",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://js.stripe.com https://*.js.stripe.com https://checkout.stripe.com 'sha256-GJpptaB9Bz6CfF0DRrD6q4aJv4Y6KtADhfPP5CcRGMQ='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://api.stripe.com https://checkout.stripe.com https://link.com https://*.link.com https://*.supabase.co wss://*.supabase.co https://*.ingest.de.sentry.io; frame-src 'self' https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://link.com https://*.link.com; child-src 'self' https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://link.com https://*.link.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; worker-src 'self' blob:"
      },
      "continue": true
    },
    {
      "src": "^/(?:premium/(?:success|checkout)|auth/confirmed|reset-password)/?$",
      "headers": {
        "X-Robots-Tag": "noindex"
      },
      "continue": true
    },
    {
      "src": "^/triage-verdicts\\.json$",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "continue": true
    },
    {
      "src": "^/assets/coding-worker/.*$",
      "headers": {
        "Content-Security-Policy": "default-src 'none'; script-src 'self' 'unsafe-eval'; connect-src 'self'",
        "X-Content-Type-Options": "nosniff",
        "Cross-Origin-Resource-Policy": "same-origin"
      },
      "continue": true
    },
    {
      "src": "^/sandbox/.*$",
      "headers": {
        "Content-Security-Policy": "default-src 'none'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src data:; font-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/assets/.*$",
      "headers": {
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/roadmap/specializations/fde/?$",
      "headers": {
        "Location": "/learn/forward-deployed-engineer/path"
      },
      "status": 308
    },
    {
      "src": "^/roadmap/specializations/fde/([^/]+)(?:/.*)?$",
      "headers": {
        "Location": "/learn/forward-deployed-engineer/path/$1"
      },
      "status": 308
    },
    {
      "src": "^/roadmap/paths/dsa-foundations(?:/.*)?$",
      "headers": {
        "Location": "/learn/software-engineer?topic=dsa"
      },
      "status": 308
    },
    {
      "src": "^/cs/topics(?:/.*)?$",
      "dest": "/index.html",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(?:sandbox/)?assets/.*$",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "handle": "hit"
    },
    {
      "src": "^/(?:sandbox/)?assets/.*$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/ingest/static/(.*)",
      "destination": "https://eu-assets.i.posthog.com/static/$1"
    },
    {
      "source": "/ingest/(.*)",
      "destination": "https://eu.i.posthog.com/$1"
    },
    {
      "source": "/topics/:slug",
      "destination": "/topics/:slug/index.html"
    },
    {
      "source": "/premium",
      "destination": "/premium/index.html"
    },
    {
      "source": "/premium/cancel",
      "destination": "/premium/cancel/index.html"
    },
    {
      "source": "/daily",
      "destination": "/daily/index.html"
    },
    {
      "source": "/daily/:date",
      "destination": "/daily/:date/index.html"
    },
    {
      "source": "/coding",
      "destination": "/coding/index.html"
    },
    {
      "source": "/coding/system-design",
      "destination": "/coding/system-design/index.html"
    },
    {
      "source": "/coding/system-design/(.*)",
      "destination": "/coding/system-design/index.html"
    },
    {
      "source": "/coding/:track",
      "destination": "/coding/:track/index.html"
    },
    {
      "source": "/coding/:track/:taskId",
      "destination": "/coding/:track/:taskId/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/learn/web-developer",
      "destination": "/learn/web-developer/index.html"
    },
    {
      "source": "/learn/software-engineer",
      "destination": "/learn/software-engineer/index.html"
    },
    {
      "source": "/((?!api/|assets/|ingest/|sandbox/|topics/).*)",
      "destination": "/index.html"
    }
  ]
}
