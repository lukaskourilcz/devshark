# Keep deployment sources limited to the application and build inputs.
**/node_modules
**/dist
/artifacts
/playwright-report
/test-results
/client/storybook-static
/.env*
/.claude
/AGENTS.md
/CLAUDE.md
/media
/bruno
/design
/triage
/docker
/Dockerfile
/packages
/tests
/client/tests
/client/stories
/client/.storybook
**/*.test.*
**/*.spec.*
/scripts/test-*
*.log

# The OG image build reads these two SVGs. Allow every parent explicitly.
/docs/*
!/docs/brand/
/docs/brand/*
!/docs/brand/source/
/docs/brand/source/*
!/docs/brand/source/approved/
/docs/brand/source/approved/*
!/docs/brand/source/approved/navbar-logo-ink.svg
!/docs/brand/source/v9/
/docs/brand/source/v9/*
!/docs/brand/source/v9/recommended/
/docs/brand/source/v9/recommended/*
!/docs/brand/source/v9/recommended/devshark-fin-wave-green.svg
