{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-public"],
  "workspaces": {
    ".": {
      "entry": [
        "api/**/*.ts",
        "docker/**/*.{mjs,ts}",
        "scripts/*.{ts,mjs}",
        "scripts/fixtures/react-busy-control.ts",
        "tests/**/*.spec.ts"
      ],
      "project": [
        "api/**/*.ts",
        "docker/**/*.{mjs,ts}",
        "lib/**/*.ts",
        "shared/**/*.ts",
        "scripts/**/*.{ts,mjs}",
        "tests/**/*.ts"
      ],
      "ignoreDependencies": [
        "lighthouse"
      ]
    },
    "client": {
      "entry": [
        "sandbox/**/*.{ts,tsx}",
        "stories/**/*.stories.tsx",
        ".storybook/*.{ts,tsx}",
        "tests/**/*.test.{ts,tsx}",
        "vite*.config.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "build/**/*.ts",
        "sandbox/**/*.{ts,tsx}",
        "tests/**/*.{ts,tsx}",
        "stories/**/*.tsx",
        ".storybook/*.{ts,tsx}",
        "*.ts"
      ],
      "vite": false,
      "ignoreDependencies": [
        "@astryxdesign/theme-neutral"
      ]
    }
  },
  "ignore": [
    "client/.storybook/public/mockServiceWorker.js"
  ],
  "ignoreBinaries": [
    "vercel",
    "psql",
    "mkfifo"
  ]
}
