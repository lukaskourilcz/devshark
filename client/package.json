    "satori": {
      "fflate": "0.7.5"
    },
    "@storybook/react-vite": {
      "@joshwooding/vite-plugin-react-docgen-typescript": "0.9.1"
    },
    "solid-js@1.9.x": {
      "seroval": "1.8.2",
      "seroval-plugins": "1.8.0"
    }
  },
  "allowScripts": {
    "esbuild": true,
    "core-js": false,
    "msw": false,
    "fsevents": false
